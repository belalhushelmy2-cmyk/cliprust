# Build a committed checkout from its repository root:
# makepkg -p packaging/linux/PKGBUILD
pkgname=cliprust
pkgver=0.1.0
pkgrel=1
pkgdesc='Native local clipboard history built with Rust and Slint (development release)'
arch=('x86_64' 'aarch64')
license=('GPL-3.0-only')
depends=('fontconfig' 'libxkbcommon' 'libx11' 'libxcb' 'wayland')
makedepends=('rust' 'cargo' 'pkgconf' 'git')
options=('!lto')

prepare() {
  local project_root="$(realpath "$startdir/../..")"
  mkdir -p "$srcdir/cliprust-$pkgver"
  git -C "$project_root" archive --format=tar HEAD | tar -xf - -C "$srcdir/cliprust-$pkgver"
}
build() {
  cd "$srcdir/cliprust-$pkgver"
  cargo build --release --locked
}
check() {
  cd "$srcdir/cliprust-$pkgver"
  cargo test --locked --all-targets
}
package() {
  cd "$srcdir/cliprust-$pkgver"
  install -Dm755 target/release/cliprust "$pkgdir/usr/bin/cliprust"
  install -Dm644 packaging/linux/cliprust.desktop "$pkgdir/usr/share/applications/cliprust.desktop"
  install -Dm644 packaging/linux/cliprust.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/cliprust.svg"
  install -Dm644 packaging/linux/org.cliprust.Cliprust.metainfo.xml "$pkgdir/usr/share/metainfo/org.cliprust.Cliprust.metainfo.xml"
  install -Dm644 README.md "$pkgdir/usr/share/doc/cliprust/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/cliprust/LICENSE"
}
